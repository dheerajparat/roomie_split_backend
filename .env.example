# ==========================================
# RoomieSplit Backend Configuration (Template)
# Copy this file to .env and adjust your settings
# ==========================================

# Application
PROJECT_NAME="RoomieSplit API"
VERSION="1.0.0"
API_V1_STR="/api"
ENVIRONMENT="development"

# Security & JWT Authentication
SECRET_KEY="replace_with_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Configuration
POSTGRES_USER="your_postgres_user"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_DB="roomie_db"

# Complete SQLAlchemy Database Connection URL
DATABASE_URL="postgresql://your_postgres_user:your_postgres_password@localhost:5433/roomie_db"

# Server Host & Port
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# CORS Allowed Origins
CORS_ORIGINS="*"
